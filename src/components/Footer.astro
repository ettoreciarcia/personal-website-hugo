---
interface Props {
  /** True when the build includes Google Analytics, so the consent controls are relevant. */
  analytics?: boolean;
}
const { analytics = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-line/60 mt-10">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 py-8 text-sm text-fg-muted">
    <p>
      © {year} Ettore Ciarcia · Built with Astro, hosted on S3 + CloudFront, deployed by GitHub Actions ·
      <a href="/index.xml" class="underline-link">RSS</a> ·
      <a href="/privacy/" class="underline-link">Privacy</a>
      {
        analytics && (
          <>
            {' · '}
            <a href="/privacy/#cookie-settings" class="underline-link" data-cookie-settings>
              Cookie settings
            </a>
          </>
        )
      }
    </p>
  </div>
</footer>
