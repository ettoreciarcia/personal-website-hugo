---
import { slugify } from '../lib/site';

interface Props {
  tags: string[];
  class?: string;
}
const { tags, class: cls = '' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-2', cls]}>
      {tags.map((t) => (
        <li>
          <a
            href={`/tags/${slugify(t)}/`}
            class="label inline-block px-2 py-1 rounded border border-line hover:border-accent hover:text-accent transition-colors"
          >
            {t}
          </a>
        </li>
      ))}
    </ul>
  )
}
