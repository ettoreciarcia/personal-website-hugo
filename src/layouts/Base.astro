---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Social card image: a content image (re-encoded to a 1200px JPEG) or a path under public/. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Only for type="article". */
  article?: { published: Date; section?: string; tags?: string[] };
  /** Keep thin or utility pages (search, tag lists, 404) out of search results. */
  noindex?: boolean;
  /** One or more schema.org objects, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Extra class for <main>, e.g. to widen a grid page. */
  mainClass?: string;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  type = 'website',
  article,
  noindex = false,
  jsonLd,
  mainClass = '',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — Kubernetes & Cloud Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// JPEG at a fixed width: every network renders it (LinkedIn ignores WebP) and the dimensions are known.
let og = { src: '/og-default.png', width: 1200, height: 630 };
if (image && typeof image !== 'string') {
  const img = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg', quality: 82 });
  og = { src: img.src, width: Number(img.attributes.width), height: Number(img.attributes.height) };
} else if (typeof image === 'string') {
  og = { src: image, width: 0, height: 0 };
}
const ogImage = new URL(og.src, Astro.site);
const ogAlt = imageAlt ?? title ?? SITE.title;

const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.title} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0a" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/index.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {og.width > 0 && <meta property="og:image:width" content={String(og.width)} />}
    {og.height > 0 && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={ogAlt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:author" content={SITE.url} />
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <!-- Apply the theme before first paint: saved choice wins, otherwise follow the OS preference -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class:list={['flex-1 w-full max-w-3xl mx-auto px-5 sm:px-6 py-10 sm:py-14', mainClass]}>
      <slot />
    </main>
    <Footer analytics={Boolean(gaId)} />
    {gaId && <CookieConsent gaId={gaId} />}
  </body>
</html>
