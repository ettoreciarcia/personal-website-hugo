---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="py-20 text-center">
    <p class="label mb-3">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-fg-muted">The page you're looking for doesn't exist or was moved.</p>
    <p class="mt-8 flex justify-center gap-5 text-sm">
      <a href="/" class="underline-link">Home</a>
      <a href="/publication/" class="underline-link">Articles</a>
      <a href="/search/" class="underline-link">Search</a>
    </p>
  </div>
</Base>
