---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getTagIndex } from '../../lib/site';

const tags = [...(await getTagIndex()).entries()].sort((a, b) => b[1].entries.length - a[1].entries.length || a[1].name.localeCompare(b[1].name));
---

<Base title="Tags" description="Browse content by tag.">
  <PageTitle eyebrow={`${tags.length} tags`} title="Tags" />
  <ul class="flex flex-wrap gap-2">
    {
      tags.map(([slug, { name, entries }]) => (
        <li>
          <a href={`/tags/${slug}/`} class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full border border-line hover:border-accent hover:text-accent transition-colors">
            {name} <span class="label">{entries.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
